void update_lcd_line1_with_distance(SystemState state, float dist) {
    char lcd_text[16];

    // Format status and distance together
    if (state == ENABLED)
        sprintf(lcd_text, "Enabled    %02d.%02din", (int)dist, (int)((dist - (int)dist) * 100));
    else
        sprintf(lcd_text, "Disabled   %02d.%02din", (int)dist, (int)((dist - (int)dist) * 100));

    // Convert string into 4 u32s
    u32 w3 = (lcd_text[0] << 24) | (lcd_text[1] << 16) | (lcd_text[2] << 8) | lcd_text[3];
    u32 w2 = (lcd_text[4] << 24) | (lcd_text[5] << 16) | (lcd_text[6] << 8) | lcd_text[7];
    u32 w1 = (lcd_text[8] << 24) | (lcd_text[9] << 16) | (lcd_text[10] << 8) | lcd_text[11];
    u32 w0 = (lcd_text[12] << 24) | (lcd_text[13] << 16) | (lcd_text[14] << 8) | lcd_text[15];

    write_lcd_line(LCD_BASE_ADDR, 0x00, w3, w2, w1, w0);
}

void update_lcd_line2(AnalogSource src) {
    if (src == POT)
        write_lcd_line(LCD_BASE_ADDR, 0x10, 0x506F7465, 0x6E74696F, 0x6D657465, 0x72202020);
    else
        write_lcd_line(LCD_BASE_ADDR, 0x10, 0x4C696768, 0x74205365, 0x6E736F72, 0x20202020);
}

void clear_lcd_line2() {
    write_lcd_line(LCD_BASE_ADDR, 0x10, 0x20202020, 0x20202020, 0x20202020, 0x20202020);
}

void system_reset(){
	pulsewidth = 0;

	Xil_Out32(0x42820000, 0);
	Xil_Out32(0x42820010, 0);

	XGpio_DiscreteWrite(&GpioLed, 1, 0);

	current_state = DISABLED;
	current_source = POT;
	reset_triggered = 1;

	write_lcd_line(LCD_BASE_ADDR, 0x00, 0x52657365, 0x74205379, 0x7374656D, 0x20202020); // "Reset System"
}

void GpioHandler(void *CallbackRef) {
    u32 btns = XGpio_DiscreteRead(&GpioBtn, 1);
    static u32 prev_btns = 0;
    u32 rising = (btns ^ prev_btns) & btns;
    prev_btns = btns;

    if (rising & BTN_Reset_BIT) {
    	system_reset();
//        current_state = DISABLED;
//        current_source = POT;
//        reset_triggered = 1;  // prevent distance update
//        write_lcd_line(LCD_BASE_ADDR, 0x00, 0x52657365, 0x74205379, 0x7374656D, 0x20202020); // "Reset System"
//        clear_lcd_line2();
    }
    if (rising & BTN_SRC_BIT) {
    	reset_triggered = 0;
        current_source = (current_source == POT) ? LIGHT : POT;
        if (current_state == ENABLED) {
        	update_lcd_line1_with_distance(current_state, (float)pulsewidth * 0.008 / 148);
        	update_lcd_line2(current_source);;
        }
    }
    if (rising & BTN_EN_BIT) {
        current_state = (current_state == ENABLED) ? DISABLED : ENABLED;
        reset_triggered = 0; // resume distance updates

        if (current_state == ENABLED) {
            update_lcd_line1_with_distance(current_state, (float)pulsewidth * 0.008 / 148);
            update_lcd_line2(current_source);
        } else {
            write_lcd_line(LCD_BASE_ADDR, 0x00, 0x44697361, 0x626C6564, 0x20202020, 0x20202020); // "Disabled"
            clear_lcd_line2();
        }
    }

    XGpio_InterruptClear(&GpioBtn, 0x1);
}

void TimerHandler(void *CallBackRef, u8 TmrCtrNumber) {
    if (TmrCtrNumber == TMRCTR_0_0){
        capture0 = Xil_In32(0x42800004);
//    	printf("capture0: %u ",capture0);
    }else if (TmrCtrNumber == TMRCTR_0_1) {
        capture1 = Xil_In32(0x42800014);
//    	printf("capture1: %u ",capture1);
        pulsewidth = (capture1 > capture0) ? (capture1 - capture0) : (capture1 - capture0 + 0xFFFFFFFF + 1);
    }
}

void init_gpio_interrupts() {
    XGpio_Initialize(&GpioBtn, GPIO_BTN_DEVICE_ID);
    XGpio_SetDataDirection(&GpioBtn, 1, 0xFF);
    XGpio_InterruptEnable(&GpioBtn, 0x1);
    XGpio_InterruptGlobalEnable(&GpioBtn);

    XScuGic_Config *cfg = XScuGic_LookupConfig(XPAR_SCUGIC_SINGLE_DEVICE_ID);
    XScuGic_CfgInitialize(&Intc, cfg, cfg->CpuBaseAddress);
    XScuGic_Connect(&Intc, XPAR_FABRIC_AXI_GPIO_1_IP2INTC_IRPT_INTR, (Xil_ExceptionHandler)GpioHandler, &GpioBtn);
    XScuGic_Enable(&Intc, XPAR_FABRIC_AXI_GPIO_1_IP2INTC_IRPT_INTR);

    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT, (Xil_ExceptionHandler)INTC_HANDLER, &Intc);
    Xil_ExceptionEnable();
}

void init_pwm() {
    u32 pwmmask = XTC_CSR_ENABLE_INT_MASK | XTC_CSR_DOWN_COUNT_MASK | XTC_CSR_AUTO_RELOAD_MASK;

    Xil_Out32(0x42810000, 0); // Clear Timer 1, TMR0
    Xil_Out32(0x42810010, 0); // Clear Timer 1, TMR1

    Xil_Out32(0x42810004, PWM_PERIOD / CLK_PERIOD); // Set period
    Xil_Out32(0x42810014, DUTY_PERIOD / CLK_PERIOD); // Set duty cycle

    pwmmask |= XTC_CSR_ENABLE_PWM_MASK | XTC_CSR_EXT_GENERATE_MASK | XTC_CSR_ENABLE_ALL_MASK;
    Xil_Out32(0x42810000, pwmmask);
    Xil_Out32(0x42810010, pwmmask);
}

void update_buzzer_pwm(float distance) {
    float freq;
    if (distance >= 24.0f) {
        Xil_Out32(0x42820000, 0);
        Xil_Out32(0x42820010, 0);
        return;
    }

    if (distance < 0) distance = 0;
    if (distance > 20) distance = 20;

    freq = 3000.0f - (distance / 20.0f) * 2000.0f;
    int pwm_period = (int)(1.0f / (freq * 1.5e-8f));
    int high_time = pwm_period / 2;

    u32 pwmmask = XTC_CSR_ENABLE_INT_MASK | XTC_CSR_DOWN_COUNT_MASK | XTC_CSR_AUTO_RELOAD_MASK;
    Xil_Out32(0x42820000 + 4, pwm_period);
    Xil_Out32(0x42820010 + 4, high_time);
    pwmmask |= XTC_CSR_ENABLE_PWM_MASK | XTC_CSR_EXT_GENERATE_MASK | XTC_CSR_ENABLE_ALL_MASK;
    Xil_Out32(0x42820000, pwmmask);
    Xil_Out32(0x42820010, pwmmask);
}

void update_servo_pwm(float angle_deg) {
    // Clamp the angle between -90° and +90°
    if (angle_deg < -90.0f) angle_deg = -90.0f;
    if (angle_deg > 90.0f) angle_deg = 90.0f;

    // Convert angle to pulse width in microseconds
    float pulse_us = 1500.0f + (angle_deg / 90.0f) * 1000.0f;

    // Convert microseconds to ticks (125 MHz )
    int high_time_ticks = (int)(pulse_us * 125.0f);  // 1us = 125 ticks
    int period_ticks = 20000 * 125;                 // 20ms = 2.5 million ticks

    // Mask setup
    u32 pwmmask = XTC_CSR_ENABLE_INT_MASK | XTC_CSR_DOWN_COUNT_MASK | XTC_CSR_AUTO_RELOAD_MASK;

    // Set period (Timer 0) and high time (Timer 1)
    Xil_Out32(0x42830004, period_ticks);
    Xil_Out32(0x42830014, high_time_ticks);

    // Enable PWM with all the jazz
    pwmmask |= XTC_CSR_ENABLE_PWM_MASK | XTC_CSR_EXT_GENERATE_MASK | XTC_CSR_ENABLE_ALL_MASK;
    Xil_Out32(0x42830000, pwmmask);
    Xil_Out32(0x42830010, pwmmask);
}

void update_motor_pwm(float duty_cycle_percent) {
    // Clamp it down, sugar — we don’t wanna blow nothin’ up
    if (duty_cycle_percent < 0.0f) duty_cycle_percent = 0.0f;
    if (duty_cycle_percent > 100.0f) duty_cycle_percent = 100.0f;

    // Convert to ticks
    const int period_ticks = 20000 * 125;  // 20ms period @ 125 MHz = 2.5 million ticks
    int high_time_ticks = (int)(period_ticks * (duty_cycle_percent / 100.0f));

    // Setup them masks just like we’re settin’ curlers before prom
    u32 pwmmask = XTC_CSR_ENABLE_INT_MASK | XTC_CSR_DOWN_COUNT_MASK | XTC_CSR_AUTO_RELOAD_MASK;

    // Set Timer 0 to full period, Timer 1 to high time
    Xil_Out32(0x42840004, period_ticks);       // Timer 0 (period)
    Xil_Out32(0x42840014, high_time_ticks);    // Timer 1 (high time)

    // Turn it on with all the fixin’s
    pwmmask |= XTC_CSR_ENABLE_PWM_MASK | XTC_CSR_EXT_GENERATE_MASK | XTC_CSR_ENABLE_ALL_MASK;
    Xil_Out32(0x42840000, pwmmask);
    Xil_Out32(0x42840010, pwmmask);
}

int TmrCtrSetupIntrSystem(INTC *IntcInstancePtr, XTmrCtr *TmrCtrInstancePtr, u16 DeviceId, u16 IntrId) {
    int Status;

    XScuGic_Config *IntcConfig;
    IntcConfig = XScuGic_LookupConfig(INTC_DEVICE_ID);
    if (NULL == IntcConfig) {
        return XST_FAILURE;
    }

    Status = XScuGic_CfgInitialize(IntcInstancePtr, IntcConfig, IntcConfig->CpuBaseAddress);
    if (Status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    XScuGic_SetPriorityTriggerType(IntcInstancePtr, IntrId, 0xA0, 0x3);

    Status = XScuGic_Connect(IntcInstancePtr, IntrId,
                              (Xil_ExceptionHandler)XTmrCtr_InterruptHandler,
                              TmrCtrInstancePtr);
    if (Status != XST_SUCCESS) {
        return XST_FAILURE;
    }

    XScuGic_Enable(IntcInstancePtr, IntrId);

    Xil_ExceptionInit();
    Xil_ExceptionRegisterHandler(XIL_EXCEPTION_ID_INT,
                                 (Xil_ExceptionHandler)INTC_HANDLER,
                                 IntcInstancePtr);
    Xil_ExceptionEnable();

    return XST_SUCCESS;
}

void Xadc_Init(XSysMon *InstancePtr, u32 DeviceId) {
    XSysMon_Config *ConfigPtr;
    ConfigPtr = XSysMon_LookupConfig(DeviceId);
    XSysMon_CfgInitialize(InstancePtr, ConfigPtr, ConfigPtr->BaseAddress);

    // Disable the Channel Sequencer before configuring the Sequence registers.
    XSysMon_SetSequencerMode(InstancePtr, XSM_SEQ_MODE_SAFE);
    // Disable all alarms
    XSysMon_SetAlarmEnables(InstancePtr, 0x0);
    // Set averaging for all channels to 16 samples
    XSysMon_SetAvg(InstancePtr, XSM_AVG_16_SAMPLES);
    // Set differential input mode for all channels
    XSysMon_SetSeqInputMode(InstancePtr, XADC_SEQ_CHANNELS);
    XSysMon_SetSeqInputMode(InstancePtr, XSM_SEQ_CH_AUX01 | XSM_SEQ_CH_AUX02 );
    // Set 6ADCCLK acquisition time in all channels
    XSysMon_SetSeqAcqTime(InstancePtr, XADC_SEQ_CHANNELS);
    // Disable averaging in all channels
    XSysMon_SetSeqAvgEnables(InstancePtr, XADC_SEQ_CHANNELS);
    // Enable all channels
    XSysMon_SetSeqChEnables(InstancePtr, XADC_SEQ_CHANNELS);
    // Set the ADCCLK frequency equal to 1/32 of System clock
    XSysMon_SetAdcClkDivisor(InstancePtr, 32);
    // Enable Calibration
    XSysMon_SetCalibEnables(InstancePtr, XSM_CFR1_CAL_PS_GAIN_OFFSET_MASK |
    XSM_CFR1_CAL_ADC_GAIN_OFFSET_MASK);
    // Enable the Channel Sequencer in continuous sequencer cycling mode
    XSysMon_SetSequencerMode(InstancePtr, XSM_SEQ_MODE_CONTINPASS);
    // Clear the old status
    // XSysMon_GetStatus(InstancePtr);
}

u8 Channel;
u16 RawData;

int main() {
    XSysMon Xadc;

    XGpio_Initialize(&GpioLed, GPIO_LED_DEVICE_ID);
    XGpio_SetDataDirection(&GpioLed, 1, 0x00);

    Xadc_Init(&Xadc, XADC_DEVICE_ID);
    Channel = 22;

    init_gpio_interrupts();
    init_pwm();

    XTmrCtr_Initialize(&TimerCtr, TMRCTR_0_ID);
    TmrCtrSetupIntrSystem(&Intc, &TimerCtr, TMRCTR_0_ID, XPAR_FABRIC_TMRCTR_0_VEC_ID);

    XTmrCtr_SetHandler(&TimerCtr, TimerHandler, &TimerCtr);

    XTmrCtr_Start(&TimerCtr, TMRCTR_0_0);
    XTmrCtr_Start(&TimerCtr, TMRCTR_0_1);

    // Enable capture mode on Timer 0 for echo pulse measurement
    u32 captureMask = XTC_CSR_ENABLE_ALL_MASK | XTC_CSR_ENABLE_INT_MASK |
                      XTC_CSR_AUTO_RELOAD_MASK | XTC_CSR_EXT_CAPTURE_MASK | XTC_CSR_CAPTURE_MODE_MASK;

    Xil_Out32(0x42800000, captureMask);  // TMR0_0 base addr
    Xil_Out32(0x42800010, captureMask);  // TMR0_1 base addr


    update_lcd_line1_with_distance(current_state, (float)pulsewidth * 0.020 / 148);

    clear_lcd_line2();

    char lcd_text[16];

    while (1) {
        float dist = (float)pulsewidth * 0.008 / 148;

//        u32 led_val = (dist >= 24.0) ? LEDG : (dist <= 12.0) ? LEDR : (LEDR | LEDG);
//        XGpio_DiscreteWrite(&GpioLed, 1, led_val);

//        xil_printf("Distance: %d.%02d inches\r\n", (int)dist, (int)((dist - (int)dist) * 100));

        // Only update LCD if not recently reset
        if (reset_triggered) {
        	continue;

        }
        update_lcd_line1_with_distance(current_state, dist);

		u32 led_val = (dist >= 24.0) ? LEDG : (dist <= 12.0) ? LEDR : (LEDR | LEDG);
		XGpio_DiscreteWrite(&GpioLed, 1, led_val);
		update_buzzer_pwm(dist);

		RawData = XSysMon_GetAdcData(&Xadc, Channel);
		if (RawData > 4095) RawData = 4095;
		int angle = ((RawData - 2047.5f) / 2047.5f) * 90.0f;

//		printf("Angle: %d\r\n",angle);

		update_servo_pwm(angle);
		update_motor_pwm(30);

    }

    return 0;
}
